# Copy to .env and fill in. Never commit .env.
# Values for the services in docker-compose.yml work as-is for local development.
PORT=3000

DATABASE_URL=postgres://screener:screener@localhost:5432/screener
# Apply pending migrations when the API starts (workers never run them).
# Or run them yourself with `npm run build && npm run migration:run`.
DB_RUN_MIGRATIONS=true

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=168

# Comma-separated frontend origins, e.g. http://localhost:5173
CORS_ORIGINS=

# Object storage for resume files (S3 API). Defaults match SeaweedFS in docker-compose.yml.
S3_ENDPOINT=http://localhost:8333
# Set when browsers must reach storage at another address than the API does.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY_ID=screener
S3_SECRET_ACCESS_KEY=screener-dev-secret
S3_FORCE_PATH_STYLE=true
# AES256 or aws:kms on AWS S3. Leave empty for SeaweedFS (it encrypts volume data).
S3_SERVER_SIDE_ENCRYPTION=
RESUME_DOWNLOAD_URL_TTL_SECONDS=300

# Processing queue (BullMQ). Matches Valkey in docker-compose.yml.
REDIS_URL=redis://localhost:6379
# Tries per resume before "Processing failed"; the first retry waits
# PROCESSING_BACKOFF_MS, and each next one twice as long.
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_BACKOFF_MS=10000

# Workers. Run them with `npm run start:worker` (one or more processes), or set
# RUN_WORKER_IN_API=true to process resumes inside the API during development.
RUN_WORKER_IN_API=false
WORKER_CONCURRENCY=4
# Resumes sent to the screening model per second, across all workers.
SCREENING_RATE_LIMIT_PER_SECOND=10
# How often stuck and failed resumes are checked, and when they count as such.
SWEEP_INTERVAL_SECONDS=60
STALE_RESUME_MINUTES=15
# Failed for a temporary reason (e.g. model down): retry after this long, at
# most this many times. 0 turns automatic retries off.
FAILED_RESUME_RETRY_AFTER_MINUTES=60
FAILED_RESUME_MAX_AUTO_RETRIES=3
# Screening model: mock (keyword matching, for development and demos) or jev.
SCREENING_MODEL=mock

# Candidate data is deleted this many days after its job is closed or deleted.
RETENTION_DAYS=365
# How often retention runs (it also retries deleting stored files).
RETENTION_INTERVAL_MINUTES=60
