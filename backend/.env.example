# Secrets and local overrides: `cp .env.example .env`, then fill in.
# Never commit .env. Everything else has a default in .env.defaults, and any
# variable from there can be overridden here.

# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services -> Credentials).
GOOGLE_CLIENT_ID=

# Database and object storage credentials. The values below match a fresh
# local docker compose setup; use new random values for any shared deployment.
# docker compose passes the S3 keys to SeaweedFS as well. Use letters, digits,
# "-" and "_" only.
POSTGRES_PASSWORD=screener
S3_ACCESS_KEY_ID=screener
S3_SECRET_ACCESS_KEY=screener-dev-secret

# Needed only with SCREENING_MODEL=gemini (https://aistudio.google.com/api-keys).
GEMINI_API_KEY=

# Turns on the operator admin API (header X-Admin-Token). At least 32
# random characters; empty keeps it off.
ADMIN_API_TOKEN=

# Optional overrides, for example:
# SCREENING_MODEL=gemini
# CORS_ORIGINS=http://localhost:5173
# HTTP_PORT=8080      # host ports of docker compose (read by compose itself)
# HTTPS_PORT=8443
