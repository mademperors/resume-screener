# Default settings. Committed; holds no secrets.
#
# Where values come from, strongest first:
#   1. real environment variables (and `environment:` in docker-compose.yml)
#   2. .env: secrets and local overrides, never committed (see .env.example)
#   3. this file
# Every variable is validated at startup (src/config/*.config.ts).

# --- API process ---
PORT=3000
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ORIGINS=
# Also process resumes inside the API process (development convenience).
RUN_WORKER_IN_API=false

# --- Database ---
# The app builds its connection from these; the Postgres container and the
# backup service read the same names. POSTGRES_PASSWORD is a secret (.env).
# Or set DATABASE_URL to a full URL, e.g. for a managed database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=screener
POSTGRES_DB=screener
# Apply pending migrations when the API starts (workers never run them).
DB_RUN_MIGRATIONS=true

# --- Sign-in sessions ---
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=168

# --- Plans (NFR 4.5): requests per minute per API key ---
PLAN_STANDARD_RATE_LIMIT=200
PLAN_EXTENDED_RATE_LIMIT=1000

# --- Object storage (S3 API; SeaweedFS locally). Keys are secrets (.env). ---
S3_ENDPOINT=http://localhost:8333
# Set when browsers reach storage at another address than the API does.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_FORCE_PATH_STYLE=true
# AES256 or aws:kms on AWS S3. Empty for SeaweedFS (it encrypts volume data).
S3_SERVER_SIDE_ENCRYPTION=
RESUME_DOWNLOAD_URL_TTL_SECONDS=300

# --- Processing queue (BullMQ on Valkey) ---
REDIS_URL=redis://localhost:6379
# Tries per resume before "Processing failed"; the first retry waits
# PROCESSING_BACKOFF_MS, each next one twice as long.
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_BACKOFF_MS=10000

# --- Workers ---
WORKER_CONCURRENCY=4
# Resumes sent to the screening model per second, across all workers.
SCREENING_RATE_LIMIT_PER_SECOND=10
# How often stuck and failed resumes are checked, and when they count as such.
SWEEP_INTERVAL_SECONDS=60
STALE_RESUME_MINUTES=15
# Failed for a temporary reason (e.g. model down): retry after this long, at
# most this many times. 0 turns automatic retries off.
FAILED_RESUME_RETRY_AFTER_MINUTES=60
FAILED_RESUME_MAX_AUTO_RETRIES=3

# --- Screening model ---
# mock (keyword matching, for development and demos) or gemini (needs
# GEMINI_API_KEY in .env).
SCREENING_MODEL=mock
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/decisions
# An exact id, so a new release can't shift the calibrated thresholds.
GEMINI_MODEL=gemini-decision-1
GEMINI_TIMEOUT_MS=15000

# --- Data retention ---
# Candidate data is deleted this many days after its job is closed or deleted.
RETENTION_DAYS=365
# How often retention runs (it also retries deleting stored files).
RETENTION_INTERVAL_MINUTES=60

# --- docker compose only ---
# Public names served over HTTPS by Caddy. Real domains get Let's Encrypt
# certificates automatically; *.localhost uses Caddy's local authority.
API_DOMAIN=localhost
FILES_DOMAIN=files.localhost
# Daily database dumps in ./backups are kept this many days.
BACKUP_KEEP_DAYS=7
